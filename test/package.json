{
  "name": "test",
  "version": "1.0.0",
  "description": "Socketnaut test suite.",
  "main": "./dist/main.js",
  "scripts": {
    "clean": "rm -rf ./dist/* && rm -rf ./ssl/*.pem",
    "build": "tsc --build .",
    "clean:build": "npm run clean && npm run build",
    "monitor": "nodemon .",
    "prep": "openssl req -newkey rsa:2048 -nodes -x509 -subj /CN=localhost -keyout ./ssl/key.pem -out ./ssl/cert.pem",
    "start": "node --expose-gc --trace-warnings .",
    "clean:build:prep:start": "npm run clean && npm run build && npm run prep && npm run start"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "network-services": "^1.1.13",
    "socketnaut": "file:..",
    "streams-logger": "^1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "type": "module",
  "private": true
}
